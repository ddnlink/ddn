{
  "name": "ddn-starter",
  "version": "3.7.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddnlink/ddn.git"
  },
  "bugs": {
    "url": "https://github.com/ddnlink/ddn/issues"
  },
  "homepage": "https://github.com/ddnlink/ddn/tree/master/packages/ddn#readme",
  "keywords": [
    "ddn",
    "blockchain",
    "bitcoin",
    "node.js",
    "web",
    "server",
    "git",
    "crypto",
    "cryptography",
    "encryption"
  ],
  "author": "DDN <support@ddn.link>",
  "contributors": [
    {
      "name": "imfly",
      "email": "kubying@foxmail.com"
    },
    {
      "name": "wangxm",
      "email": "softwaiter@126.com"
    }
  ],
  "license": "AGPL 3.0",
  "engines": {
    "node": ">=10.21.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --experimental-modules dist/index.js",
    "start": "cross-env NODE_ENV=development node --experimental-modules app.js",
    "test": "./node_modules/.bin/mocha test/**/*.test.js",
    "clear": "rm db/contracts/* && rm db/*.db && rm logs/*.log",
    "clear:testnet": "rm -rf db/testnet/* && rm -rf logs/testnet/*",
    "clear:localnet": "rm -rf db/localnet/* && rm -rf logs/localnet/*",
    "test:localnet": "./node_modules/.bin/mocha test/localnet/**/*.test.js",
    "build": "father build",
    "build:prod": "cross-env NODE_ENV=production ./node_modules/.bin/gulp linux-build-main",
    "build:src": "./node_modules/.bin/gulp build-src-main",
    "build-testnet": "./node_modules/.bin/gulp linux-build-test",
    "build-localnet": "./node_modules/.bin/gulp linux-build-local"
  },
  "dependencies": {
    "@ddn/asset-aob": "^1.2.3",
    "@ddn/asset-base": "workspace:*",
    "@ddn/asset-dao": "^1.2.2",
    "@ddn/asset-dapp": "^2.4.3",
    "@ddn/asset-evidence": "^2.4.3",
    "@ddn/core": "workspace:*",
    "@ddn/crypto": "workspace:*",
    "@ddn/crypto-nacl": "workspace:*",
    "@ddn/crypto-sm": "workspace:*",
    "@ddn/peer": "workspace:*",
    "@ddn/utils": "workspace:*",
    "commander": "2.6.0",
    "lodash": "^4.17.11"
  },
  "devDependencies": {
    "cross-env": "^5.1.3",
    "gulp": "5.0.0",
    "gulp-replace": "1.1.4",
    "gulp-shell": "0.8.0",
    "gulp-uglify": "3.0.2",
    "uglifyjs-webpack-plugin": "^2.2.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0",
    "webpack-stream": "^7.0.0"
  }
}
