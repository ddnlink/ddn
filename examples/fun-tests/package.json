{
  "name": "ddn-starter",
  "version": "3.8.0-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddnlink/ddn.git"
  },
  "bugs": {
    "url": "https://github.com/ddnlink/ddn/issues"
  },
  "homepage": "https://github.com/ddnlink/ddn/tree/master/packages/ddn#readme",
  "keywords": [
    "ddn",
    "blockchain",
    "bitcoin",
    "node.js",
    "web",
    "server",
    "git",
    "crypto",
    "cryptography",
    "encryption"
  ],
  "author": "DDN <support@ddn.link>",
  "contributors": [
    {
      "name": "imfly",
      "email": "kubying@foxmail.com"
    },
    {
      "name": "wangxm",
      "email": "softwaiter@126.com"
    }
  ],
  "license": "AGPL 3.0",
  "engines": {
    "node": ">=10.21.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development node --experimental-modules dist/index.js",
    "dev": "cross-env NODE_ENV=development node --experimental-modules app.js",
    "build": "pnpm build:linux:main",
    "build:win64:local": "node esbuild.config.js win64 localnet",
    "build:linux:local": "node esbuild.config.js linux localnet",
    "build:mac:local": "node esbuild.config.js mac localnet",
    "build:win64:test": "NODE_ENV=production node esbuild.config.js win64 testnet",
    "build:linux:test": "NODE_ENV=production node esbuild.config.js linux testnet",
    "build:mac:test": "NODE_ENV=production node esbuild.config.js mac testnet",
    "build:win64:main": "NODE_ENV=production node esbuild.config.js win64 mainnet",
    "build:linux:main": "NODE_ENV=production node esbuild.config.js linux mainnet",
    "build:mac:main": "NODE_ENV=production node esbuild.config.js mac mainnet",
    "build:prod": "cross-env NODE_ENV=production ./node_modules/.bin/gulp linux-build-main",
    "build:src": "./node_modules/.bin/gulp build-src-main",
    "build:testnet": "./node_modules/.bin/gulp linux-build-test",
    "build:localnet": "./node_modules/.bin/gulp linux-build-local",
    "test": "./node_modules/.bin/mocha test/**/*.test.js",
    "clean": "rm db/contracts/* && rm db/*.db && rm logs/*.log",
    "clean:testnet": "rm -rf db/testnet/* && rm -rf logs/testnet/*",
    "clean:localnet": "rm -rf db/localnet/* && rm -rf logs/localnet/*",
    "test:localnet": "./node_modules/.bin/mocha test/localnet/**/*.test.js"
  },
  "dependencies": {
    "@ddn/core": "workspace:^",
    "@ddn/peer": "workspace:^",
    "commander": "2.6.0"
  },
  "devDependencies": {
    "cross-env": "^5.1.3",
    "esbuild": "^0.23.1",
    "fs-extra": "0.30.0",
    "lodash": "^4.17.21",
    "which": "^5.0.0"
  }
}
