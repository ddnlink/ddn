{
  "version": "2.4.1-alpha.0",
  "changelog": {
    "labels": {
      "pr(enhancement)": ":improvement: Enhancement",
      "pr(bug)": ":bug: Bug Fix",
      "pr(documentation)": ":docs: Documentation",
      "pr(dependency)": ":deciduous_tree: Dependency",
      "pr(chore)": ":turtle: Chore"
    },
    "repo": "ddnlink/ddn",
    "cacheDir": ".changelog"
  },
  "packages": ["packages/*", "pro-packages/*", "examples/*"],
  "publishConfig": {
    "access": "public"
  },
  "command": {
    "publish": {
      "git-tag-version": false,
      "push": false,
      "npmClient": "npm",
      "ignoreChanges": ["**/*.md", "**/test/**"],
      "message": "chore(release): publish",
      "registry": "https://registry.npmjs.org"
    }
  },
  "npmClient": "npm"
}
