{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ],
            "cache": false
        },
        "dev": {
            "cache": false
        },
        "test": {
            "outputs": [
                ".jest-cache/**"
            ]
        },
        "@ddn/utils#build": {
            "dependsOn": [],
            "outputs": [
                "dist/**"
            ]
        },
        "@ddn/core#build": {
            "dependsOn": [
                "@ddn/utils#build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "@ddn/crypto#build": {
            "dependsOn": [
                "@ddn/utils#build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "@ddn/node-sdk#build": {
            "dependsOn": [
                "@ddn/utils#build",
                "@ddn/crypto#build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "@ddn/peer#build": {
            "dependsOn": [
                "@ddn/utils#build",
                "@ddn/core#build",
                "@ddn/crypto#build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "@ddn/asset-dao#build": {
            "dependsOn": [
                "@ddn/asset-base#build",
                "@ddn/crypto#build",
                "@ddn/utils#build"
            ],
            "outputs": [
                "dist/**"
            ]
        }
    },
    "globalEnv": [
        "DDN_ENV",
        "NODE_ENV"
    ],
    "globalDependencies": [
        "tsconfig.base.json",
        "tsconfig.json",
        "jest.config.ts",
        ".father.base.ts"
    ]
}