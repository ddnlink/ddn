{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "build:extra": {
            "cache": false
        },
        "dev": {
            "cache": false
        },
        "test": {
            "outputs": [
                ".jest-cache/**"
            ]
        }
    },
    "globalEnv": [
        "DDN_ENV",
        "NODE_ENV"
    ],
    "globalDependencies": [
        ".env",
        ".ddnrc.js",
        "tsconfig.base.json",
        "tsconfig.json",
        "jest.config.ts",
        ".father.base.ts",
        "jest.config.ts",
        ".father.base.ts"
    ],
    "ui": "tui"
}