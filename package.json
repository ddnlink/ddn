{
  "name": "ddn",
  "version": "3.8.0.alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddnlink/ddn.git"
  },
  "bugs": {
    "url": "https://github.com/ddnlink/ddn/issues"
  },
  "homepage": "https://github.com/ddnlink/ddn#readme",
  "keywords": [
    "ddn",
    "blockchain",
    "bitcoin",
    "node.js",
    "web",
    "server",
    "crypto",
    "cryptography",
    "encryption"
  ],
  "scripts": {
    "dev": "turbo dev --force",
    "build": "turbo build  --force --no-cache",
    "build:dev": "NODE_ENV=development node ./scripts/initCryptoDependent.js && father build -w",
    "build:docker": "node ./scripts/initCryptoDependent.js && father build --docker",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "pnpm lint:fix && pnpm prettier",
    "lint": "eslint --ext .js packages/**/src",
    "lint:fix": "eslint --fix --ext .js packages/**/src",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js",
    "prettier": "prettier --write ./packages/**/src/**/**/* ./packages/**/test/**/**/*",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -w",
    "chore:update-deps": "sh ./scripts/reinstall_deps.sh",
    "clean": "pnpm clean:turbo && pnpm clean:history && pnpm clean:cache && pnpm clean:dist && pnpm store prune && pnpm clean:node_modules",
    "clean:turbo": "rimraf .turbo */**/.turbo",
    "clean:history": "rimraf .history */**/.history",
    "clean:cache": "rimraf .cache */**/.cache",
    "clean:dist": "rimraf packages/**/dist pro-packages/**/dist",
    "clean:node_modules": "rimraf */**/node_modules && rimraf node_modules",
    "docker:start": "docker compose -f ./docker/docker-compose.yml --env-file ./docker/.env start",
    "docker:stop": "docker compose -f ./docker/docker-compose.yml --env-file ./docker/.env stop",
    "docker:up": "docker compose -f ./docker/docker-compose.yml --env-file ./docker/.env up -d",
    "docker:down": "docker compose -f ./docker/docker-compose.yml --env-file ./docker/.env down",
    "doc:dev": "DDN_ENV=docs dumi dev",
    "doc:build": "DDN_ENV=docs dumi build",
    "doc:deploy": "DDN_ENV=docs deploy website",
    "pkg:fix": "manypkg fix",
    "postinstall": "manypkg check && node scripts/copy-sqlite3.js"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "author": "DDN <support@ddn.link>",
  "license": "AGPL 3.0",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{ts,txs,js,jsx,less}": [
      "prettier --write",
      "git add"
    ],
    "*.js": "eslint --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=14 <=18"
  },
  "dependencies": {
    "@babel/plugin-transform-classes": "^7.10.4",
    "@ddn/ddn-cli": "2.5.2",
    "@ddn/js-sdk": "link:packages/js-sdk",
    "@jest/transform": "^29.7.0",
    "@manypkg/cli": "^0.21.4",
    "@types/jest": "^23.3.2",
    "@types/node": "^10.12.26",
    "@typescript-eslint/eslint-plugin": "^3.3.0",
    "@typescript-eslint/parser": "^3.3.0",
    "conventional-changelog": "^3.1.21",
    "conventional-changelog-cli": "^2.2.2",
    "dumi": "^1.0.3",
    "esbuild": "^0.23.0",
    "eslint": "^7.11.0",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "^2.21.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "father": "^4.5.3",
    "husky": "^8.0.3",
    "identity-obj-proxy": "3.0.0",
    "jest": "^27.0.6",
    "jest-esm-transformer": "^1.0.0",
    "jest-playwright-preset": "^4.0.0",
    "lerna": "^8.1.5",
    "lint-staged": "^10.4.0",
    "prettier": "^2.1.2",
    "rimraf": "2.5.4",
    "rollup-plugin-node-builtins": "^2.1.2",
    "rollup-plugin-node-globals": "^1.4.0",
    "slash2": "2.0.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.0.9",
    "typescript": "^3.9.10"
  },
  "packageManager": "pnpm@10.7.1"
}
