{
  "name": "@ddn/js-sdk",
  "version": "2.5.8",
  "description": "DDN browser js SDK",
  "main": "dist/index.js",
  "module": "build/index.js",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "build",
    ".ddnrc.js"
  ],
  "scripts": {
    "test": "mocha test",
    "build": "DDN_NAME=ddn father build",
    "build:dev": "DDN_NAME=dev father build",
    "release": "pnpm publish --no-git-checks --access public"
  },
  "keywords": [
    "ddn",
    "node",
    "sdk"
  ],
  "author": "wxx",
  "license": "AGPL 3.0",
  "repository": {
    "type": "git",
    "url": "http://github.com/ddnlink/ddn/tree/master/packages/js-sdk"
  },
  "homepage": "http://github.com/ddnlink/ddn/tree/master/packages/js-sdk",
  "bugs": {
    "url": "http://github.com/ddnlink/ddn/issues"
  },
  "dependencies": {
    "bignumber.js": "^7.2.1",
    "buffer": "^4.7.0",
    "bytebuffer": "^5.0.1",
    "crypto-browserify": "^3.12.1",
    "lodash": "^4.17.11",
    "ripemd160": "^2.0.2",
    "safe-buffer": "^5.2.1"
  },
  "browser": {
    "crypto": "crypto-browserify",
    "stream": "stream-browserify",
    "buffer": "buffer"
  },
  "npmFileMap": [
    {
      "basePath": "/dist/",
      "files": [
        "*.js"
      ]
    },
    {
      "basePath": "/build/",
      "files": [
        "*.js"
      ]
    }
  ],
  "devDependencies": {
    "@ddn/test-utils": "workspace:^",
    "browserify": "^13.1.0",
    "rollup-plugin-replace": "^2.2.0",
    "stream-browserify": "^3.0.0",
    "tinyify": "^2.5.2"
  },
  "gitHead": "3f5aef8e697748180be42f047a2053e46a7afd43"
}
