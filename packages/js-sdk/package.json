{
  "name": "@ddn/js-sdk",
  "version": "2.5.5",
  "description": "DDN browser js SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "build",
    ".ddnrc.js"
  ],
  "scripts": {
    "test": "mocha test",
    "build": "father build",
    "build:custom": "DDN_ENV=custom pnpm build:custom:dev & pnpm build:custom:prod",
    "build:dev": "browserify index.js > ./build/index.browserify.js",
    "build:prod": "mkdir -p build && browserify index.js -p tinyify > ./build/ddn.min.js",
    "build:custom:prod": "browserify index.js -p tinyify > ./build/ddn-js-sdk.custom.min.js"
  },
  "keywords": [
    "ddn",
    "node",
    "sdk"
  ],
  "author": "wxx",
  "license": "AGPL 3.0",
  "repository": {
    "type": "git",
    "url": "http://github.com/ddnlink/ddn/tree/master/packages/node-sdk"
  },
  "homepage": "http://github.com/ddnlink/ddn/tree/master/packages/node-sdk",
  "bugs": {
    "url": "http://github.com/ddnlink/ddn/issues"
  },
  "dependencies": {
    "@ddn/asset-base": "workspace:^",
    "@ddn/core": "workspace:^",
    "@ddn/crypto": "workspace:^",
    "@ddn/crypto-nacl": "workspace:^",
    "@ddn/crypto-sm": "workspace:^",
    "@ddn/test-utils": "workspace:^",
    "@ddn/utils": "workspace:^",
    "JSONStream": "^1.3.1",
    "buffer": "^4.7.0",
    "bytebuffer": "^5.0.1",
    "lodash": "^4.17.11",
    "long": "^4.0.0",
    "ripemd160": "^2.0.2",
    "safe-buffer": "^5.2.1",
    "through2": "^2.0.3"
  },
  "npmFileMap": [
    {
      "basePath": "/dist/",
      "files": [
        "*.js"
      ]
    }
  ],
  "devDependencies": {
    "browserify": "^13.1.0",
    "rollup-plugin-replace": "^2.2.0",
    "tinyify": "^2.5.2"
  },
  "gitHead": "3f5aef8e697748180be42f047a2053e46a7afd43"
}
