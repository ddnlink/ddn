{
  "name": "@ddn/js-sdk",
  "version": "2.5.6",
  "description": "DDN browser js SDK",
  "main": "dist/index.js",
  "files": [
    "dist",
    ".ddnrc.js"
  ],
  "scripts": {
    "test": "mocha test",
    "build:ddn": "DDN_NAME=ddn father build",
    "build": "DDN_NAME=dev father build",
    "build:dev": "mkdir -p build && browserify src/index.js > ./build/index.browserify.js",
    "build:prod": "mkdir -p build && browserify index.js -p tinyify > ./build/ddn.min.js",
    "build:custom:prod": "browserify index.js -p tinyify > ./build/ddn-js-sdk.custom.min.js"
  },
  "keywords": [
    "ddn",
    "node",
    "sdk"
  ],
  "author": "wxx",
  "license": "AGPL 3.0",
  "repository": {
    "type": "git",
    "url": "http://github.com/ddnlink/ddn/tree/master/packages/js-sdk"
  },
  "homepage": "http://github.com/ddnlink/ddn/tree/master/packages/js-sdk",
  "bugs": {
    "url": "http://github.com/ddnlink/ddn/issues"
  },
  "dependencies": {
    "bignumber.js": "^7.2.1",
    "buffer": "^4.7.0",
    "bytebuffer": "^5.0.1",
    "crypto-browserify": "^3.12.1",
    "lodash": "^4.17.11",
    "ripemd160": "^2.0.2",
    "safe-buffer": "^5.2.1"
  },
  "npmFileMap": [
    {
      "basePath": "/dist/",
      "files": [
        "*.js"
      ]
    }
  ],
  "devDependencies": {
    "@ddn/test-utils": "workspace:^",
    "browserify": "^13.1.0",
    "rollup-plugin-replace": "^2.2.0",
    "tinyify": "^2.5.2"
  },
  "gitHead": "3f5aef8e697748180be42f047a2053e46a7afd43"
}
